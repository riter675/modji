# Optional production provider credentials; never commit real secrets.
HERE_API_KEY=
HERE_TRAFFIC_API_KEY=

# Primary Postgres URL from Vercel or a compatible provider.
DATABASE_URL_POOLED=

# Optional serverless Redis. With these values, distributed rate limiting is
# enabled; without them the account/community API uses database-backed limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional self-hosted Valhalla URL. Defaults to the community demo for low-volume development.
VALHALLA_URL=

# Local Docker Compose only; replace before deployment.
POSTGRES_PASSWORD=modji_local_dev
REDIS_PASSWORD=modji_local_dev
